{
  "name": "dsh-shortcut-restart",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Adds a “Restart container” row to the account menu at the sidebar foot; the row runs the deployment's reboot command.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [ "index.js", "client.js", "cordis.patch.yml", "locale/*.json", "docs", "icon.svg" ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true }
  }
}
